# Copy to .env. install.sh fills LAN_IP for you if you leave it blank.
LAN_IP=
# How often the house is scanned, in minutes.
SCAN_EVERY=10
# Look up unknown hardware makers online (sends only the 3-byte maker prefix, never the full address). off | on
OUI_LOOKUP=off
# The MCP connector: lets an AI you choose read the house and ask for a fix. You answer on the page. Off while blank.
# A password of 24 characters or more. Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NEARBY_MCP_TOKEN=
# Hour (local) the evening letter is written.
LETTER_HOUR=20
