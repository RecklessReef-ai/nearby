# Copy to .env. install.sh fills LAN_IP for you if you leave it blank.
LAN_IP=
# How often the house is scanned, in minutes.
SCAN_EVERY=10
# Look up unknown hardware makers online (sends only the 3-byte maker prefix, never the full address). off | on
OUI_LOOKUP=off
# Day 5: NEAR AI Cloud, Private TEE tier. Leave blank to stay local.
NEAR_AI_API_KEY=
# Which sealed model writes the letter. Must be one NEAR AI serves in its own TEE (see app/nearby/brain.py SEALED_MODELS).
NEAR_AI_MODEL=Qwen/Qwen3.8-27B
# Caps, enforced in code outside the model. Past a cap the letter is written locally until tomorrow.
CAP_TOKENS_DAY=50000
CAP_USD_MONTH=1.00
# Hour (local) the evening letter is written.
LETTER_HOUR=20
